# ==============================================================================
# VANTAGE VIRALITY OS V2 — ENVIRONMENT VARIABLES & PROVIDER CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure your production API credentials.
# Note: The application operates in high-fidelity DEMO DATA mode when keys are omitted.

# 1. YouTube Data API v3 (search.list, videos.list, channels.list)
# Get key from Google Cloud Console: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# 2. Google Trends / SerpApi / Data Provider
GOOGLE_TRENDS_API_KEY=

# 3. Reddit API (OAuth Client Credentials for r/all, subreddit momentum)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# 4. Instagram Graph API / Compliant Partner Data Provider
INSTAGRAM_ACCESS_TOKEN=

# 5. AI Ideation & Content Calibration LLM (Gemini / Claude / OpenAI)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-pro

# 6. Trend Engine Worker Schedule (e.g. cron: every 2 hours)
TREND_WORKER_INTERVAL_HOURS=2
CACHE_TTL_MINUTES=120
